{
  "name": "codeatlas-backend",
  "version": "1.0.0",
  "description": "CodeAtlas AI Backend - AST Parser and Graph API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "scan": "tsx src/scripts/scanRepo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "^7.23.6",
    "@babel/traverse": "^7.23.6",
    "@babel/types": "^7.23.6",
    "@fastify/cors": "^8.4.2",
    "@fastify/rate-limit": "^7.6.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.1",
    "neo4j-driver": "^5.15.0",
    "simple-git": "^3.36.0",
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.20.4",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
