# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Server Configuration
PORT=3001
NODE_ENV=development

# Comma-separated allowlist of browser origins permitted to call the API.
# Leave unset for same-origin only. Do NOT use "*": that would let any website
# call this API from a visitor's browser.
# CORS_ORIGINS=http://localhost:5173

# GitHub token. Required only for private repositories; scope it as narrowly as
# possible (read-only contents is enough for analysis).
# GITHUB_TOKEN=ghp_...

# Language model key. Without it the assistant still answers using lexical
# retrieval only, and labels its answers retrieval-only.
# GEMINI_API_KEY=...

# Repository ingestion
# Where clones are written. Defaults to .codeatlas-repos in the working dir.
# CLONE_ROOT=/var/lib/codeatlas/repos
# Keep clones after scanning (handy locally, costly on a server).
# KEEP_CLONE_AFTER_SCAN=false
# CLONE_MAX_AGE_HOURS=1

# Limits
# MAX_FILES_PER_SCAN=20000
# JOB_CONCURRENCY=2
