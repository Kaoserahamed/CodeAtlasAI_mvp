# Base URL of the CodeAtlas backend API.
# The backend and frontend are served from different origins in development,
# so the dev server proxies /api instead. Set this when the API lives
# somewhere else, such as a deployed backend or a tunnel.
# VITE_API_BASE_URL=http://localhost:3001/api

# Loads the pre-built demo graph instead of calling the API. Leave false to
# analyze a live repository.
VITE_DEMO_MODE=false